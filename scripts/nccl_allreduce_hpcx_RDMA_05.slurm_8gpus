#!/bin/bash
#SBATCH --job-name=nccl_16GPU_RoCE
#SBATCH --nodes=1                  # 2 physical nodes
#SBATCH --ntasks-per-node=8        # 8 MPI ranks per node (1 per GPU)
#SBATCH --gres=gpu:8               # Request all 8 GPUs per node
#SBATCH --chdir=/lambda/nfs/AIML/home/majid
#SBATCH --output=/lambda/nfs/AIML/home/majid/max_speed_test.%j.out

# Load HPC-X
source /lambda/nfs/AIML/hpcx/hpcx-v2.21.3-gcc-doca_ofed-ubuntu22.04-cuda12-x86_64/hpcx-init.sh
hpcx_load
ulimit -l unlimited

# 1. CAPTURE MASTER IP (eno1)
MASTER_NODE=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n 1)
MASTER_PHYS_IP=$(srun --nodes=1 --ntasks=1 -w $MASTER_NODE ip -4 addr show eno1 | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)

# 2. SET PERFORMANCE FLAGS
export NCCL_DEBUG=INFO
export NCCL_COMM_ID="$MASTER_PHYS_IP:12345"
export NCCL_IB_DISABLE=0
export NCCL_NET=IB
export NCCL_IB_GID_INDEX=3
export NCCL_SOCKET_IFNAME=eno1

# On 8-GPU nodes, we usually let NCCL auto-detect the HCAs.
# If you have multiple 50G cards, this will use all of them.
# unset NCCL_IB_HCA 

# 3. RUN THE TEST
# -np 16: Total GPUs (2 nodes * 8 GPUs)
# -g 1: Each rank manages 1 GPU
mpirun -np 16 \
  --bind-to none \
  --mca btl_tcp_if_include wg0 \
  --mca oob_tcp_if_include wg0 \
  -x NCCL_DEBUG=INFO \
  -x NCCL_COMM_ID \
  -x NCCL_IB_DISABLE=0 \
  -x NCCL_IB_GID_INDEX=3 \
  -x NCCL_NET=IB \
  -x LD_LIBRARY_PATH \
  /lambda/nfs/AIML/nccl-tests/build/all_reduce_perf -b 128M -e 4G -f 2 -g 1 -n 100 -w 20
