#!/bin/bash
#SBATCH --job-name=nccl_1node_8GPU
#SBATCH --partition=main
#SBATCH --nodes=1                  # 1. Change to 1 node
#SBATCH --ntasks-per-node=8        # 2. Keep 8 ranks (1 per GPU)
#SBATCH --gres=gpu:8               # 3. Request all 8 GPUs
#SBATCH --chdir=/lambda/nfs/AIML/home/majid
#SBATCH --output=/lambda/nfs/AIML/home/majid/single_node_test.%j.out

# Load HPC-X
source /lambda/nfs/AIML/hpcx/hpcx-v2.21.3-gcc-doca_ofed-ubuntu22.04-cuda12-x86_64/hpcx-init.sh
hpcx_load
ulimit -l unlimited

# On a single node, we can just use the local IP for the handshake
export MASTER_IP=$(ip -4 addr show eno1 | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)

# NCCL Settings
export NCCL_DEBUG=INFO
export NCCL_COMM_ID="$MASTER_IP:12345"

# Since it's one node, we want to maximize NVLink
export NCCL_P2P_DISABLE=0          # Ensure Peer-to-Peer (NVLink) is ON
export NCCL_IB_DISABLE=1            # Disable network card (not needed for 1 node)

# RUN THE TEST
# -np 8: Total GPUs on this one node
mpirun -np 8 \
  --bind-to none \
  -x NCCL_DEBUG=INFO \
  -x NCCL_COMM_ID \
  -x LD_LIBRARY_PATH \
  /lambda/nfs/AIML/nccl-tests/build/all_reduce_perf -b 128M -e 4G -f 2 -g 1 -n 100 -w 20
