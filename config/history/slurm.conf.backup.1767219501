# slurm.conf - Slurm configuration file
# Generated by Ansible

ClusterName=lambda_cluster
# BEGIN ANSIBLE MANAGED - Node Definitions
# Node Configuration with Core Reservations
# Total: 30 cores, Reserved: 2 cores, Available: 28 cores
NodeName=node-01 NodeAddr=192.168.37.3 CPUs=28 RealMemory=200120 Gres=gpu:a10:1 State=UNKNOWN
NodeName=node-02 NodeAddr=192.168.37.4 CPUs=28 RealMemory=200120 Gres=gpu:a10:1 State=UNKNOWN

# Partition Configuration
PartitionName=main Nodes=node-[01-02] Default=YES MaxTime=INFINITE State=UP
# END ANSIBLE MANAGED - Node Definitions

# Use WireGuard VPN IP for head node
SlurmctldHost=head-slurm(192.168.37.2)

# Mail program (disable if not needed)
MailProg=/bin/true

# Authentication
AuthType=auth/munge
CryptoType=crypto/munge

# Scheduling
SchedulerType=sched/backfill
SelectType=select/cons_tres
# BEGIN ANSIBLE MANAGED - Core Specialization
# Core Specialization - Reserve cores for system use
# This prevents Slurm from scheduling jobs on these cores

# Reserve 2 cores per node for system/Slurm daemons
# Format: CoreSpecCount=<number of cores to reserve>
CoreSpecCount=2

# Also reserve some memory for system
MemSpecLimit=16000
# END ANSIBLE MANAGED - Core Specialization
SelectTypeParameters=CR_Core

# Logging
SlurmctldDebug=info
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdDebug=info
SlurmdLogFile=/var/log/slurm/slurmd.log

# Process tracking
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup

# Directories
StateSaveLocation=/var/spool/slurm/ctld
SlurmdSpoolDir=/var/spool/slurm/d
SlurmctldPidFile=/var/run/slurm/slurmctld.pid
SlurmdPidFile=/var/run/slurm/slurmd.pid

# Timeouts
SlurmctldTimeout=300
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0

# Return to service
ReturnToService=2

# Node definitions - using WireGuard VPN IPs (192.168.37.x)
###NodeName=node-01 NodeAddr=192.168.37.3 CPUs=30 RealMemory=216120 State=UNKNOWN
###NodeName=node-02 NodeAddr=192.168.37.4 CPUs=30 RealMemory=216120 State=UNKNOWN
#

NodeName=node-01 NodeAddr=192.168.37.3 CPUs=28 RealMemory=200120 Gres=gpu:a10:1 State=UNKNOWN
NodeName=node-02 NodeAddr=192.168.37.4 CPUs=28 RealMemory=200120 Gres=gpu:a10:1 State=UNKNOWN



# Partition definition
PartitionName=main Nodes=node-01,node-02 Default=YES MaxTime=INFINITE State=UP
GresTypes=gpu
