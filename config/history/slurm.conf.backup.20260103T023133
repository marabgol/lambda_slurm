# slurm.conf - Slurm configuration file
# Generated by Ansible - DO NOT EDIT MANUALLY

ClusterName=hybrid-cluster

# Controller Configuration - Using WireGuard VPN IP
SlurmctldHost=head-slurm(192.168.37.2)

# Mail program
MailProg=/bin/mail

# Authentication
AuthType=auth/munge
CryptoType=crypto/munge

# Scheduling
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory

# Job Priority
PriorityType=priority/multifactor
PriorityWeightAge=1000
PriorityWeightFairshare=10000
PriorityWeightJobSize=1000
PriorityWeightPartition=1000
PriorityWeightQOS=10000

# Accounting (if enabled)
AccountingStorageType=accounting_storage/none
JobAcctGatherType=jobacct_gather/none

# Logging
SlurmctldDebug=info
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdDebug=info
SlurmdLogFile=/var/log/slurm/slurmd.log

# Process tracking
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity

# Directories
StateSaveLocation=/var/spool/slurm/ctld
SlurmdSpoolDir=/var/spool/slurm/d
SlurmctldPidFile=/var/run/slurm/slurmctld.pid
SlurmdPidFile=/var/run/slurm/slurmd.pid

# Timeouts
SlurmctldTimeout=300
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0
MessageTimeout=60

# Return to service
ReturnToService=2

# GPU Resources (if GPUs detected)
GresTypes=gpu

# Node Definitions - Using WireGuard VPN IPs (192.168.37.x)
# Reserve cores for system tasks (default: 2 cores reserved per node)
NodeName=node-01 NodeAddr=192.168.37.3 CPUs=30 RealMemory=210375 Gres=gpu:a100sxm440gb:1 State=UNKNOWN
NodeName=node-02 NodeAddr=192.168.37.4 CPUs=30 RealMemory=210375 Gres=gpu:a100sxm440gb:1 State=UNKNOWN

# Partition Definition
PartitionName=main Nodes=node-01,node-02 Default=YES MaxTime=INFINITE State=UP OverSubscribe=NO
